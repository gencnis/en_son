        android:pathData="M35.21,47.16 A20,20 0 1,1 35.21,60.84"
        android:strokeWidth="5"
        android:strokeColor="#FBF7F2"
        android:strokeLineCap="round" />

    <!-- Arrow head. -->
    <path
        android:pathData="M31.53,42.63 L34.18,49.98 L40.93,46.05"
        android:strokeWidth="5"
        android:strokeColor="#FBF7F2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Hands. -->
    <path
        android:pathData="M54,42 L54,54 L62,59"
        android:strokeWidth="4.5"
        android:strokeColor="#FBF7F2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
